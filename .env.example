# Copy to .env.local (gitignored) and fill in a key.
#
# Node scripts (pnpm probe:llm, pnpm bench) read .env.local directly.
# The Convex deployment has its own environment: push these values to it with
#   pnpm env:push
# Every name here is declared in services/backend/convex/convex.config.ts.

# --- LLM provider (docs/ARCHITECTURE.md §5.1) ---
# openrouter (default) | anthropic
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Optional attribution headers sent to OpenRouter. Left empty, nothing is sent.
OPENROUTER_APP_NAME=
OPENROUTER_SITE_URL=
# OpenRouter's credit fee, reported as its own line beside model spend.
OPENROUTER_FEE_PCT=5.5
# Only used when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Capability flags to switch off for the provider, from `pnpm probe:llm`,
# e.g. effort,prompt_cache. Empty = everything on.
LLM_CAPS_OFF=

# --- Model roles: canonical IDs, mapped per provider by llm/registry.ts (§5.2) ---
# Bulk matching: one call per tender position.
LLM_MATCH_MODEL=claude-haiku-5-5
LLM_MATCH_EFFORT=low
# Second read of positions the matcher could not settle. Empty = off, and those
# positions go to the review queue. Example: claude-sonnet-5-5
LLM_ESCALATION_MODEL=
LLM_ESCALATION_EFFORT=medium
# Drafts a suggested resolution for a flagged position.
LLM_INVESTIGATOR_MODEL=claude-haiku-5-5
LLM_INVESTIGATOR_EFFORT=low

# --- Guards ---
# Hard stop for model spend per UTC day, and within a single run.
LLM_DAILY_BUDGET_USD=3
RUN_MAX_USD=1.5

# --- Demo (takes effect from milestone M3) ---
# replay = recorded runs, no model calls | live = real runs
DEMO_MODE=replay
# Live mode needs this code: open the app once with ?code=<it>.
DEMO_ACCESS_CODE=change-me
